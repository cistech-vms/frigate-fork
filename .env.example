# Headless mode enabled by default
FRIGATE_HEADLESS=true

# Authentication mode: hmac | jwt | none
FRIGATE_API_AUTH_MODE=hmac

# HMAC key registry JSON
# signature = sha256(raw_body + x-timestamp + secret)
FRIGATE_API_HMAC_KEYS_JSON={"edge-admin":{"secret":"change-me-admin","role":"admin","tenant_id":"tenant-acme"},"edge-reader":{"secret":"change-me-reader","role":"reader","tenant_id":"tenant-acme"}}
FRIGATE_API_HMAC_MAX_SKEW_SEC=300

# JWT mode secret (used only when FRIGATE_API_AUTH_MODE=jwt)
FRIGATE_API_JWT_SECRET=change-me-jwt

# Rate limiting per key/IP per minute
FRIGATE_API_RATE_LIMIT_PER_MIN=120

# Optional single-tenant pin (if set, tenant_id becomes implicit)
FRIGATE_TENANT_ID=tenant-acme

# CORS allowlist (disabled by default when empty)
FRIGATE_CORS_ALLOWLIST=

# Metrics endpoint on /metrics
FRIGATE_METRICS_ENABLED=true

# Runtime/readiness gates for production test
FRIGATE_DB_DRIVER=sqlite
FRIGATE_REDIS_ENABLED=false
FRIGATE_REDIS_URL=redis://127.0.0.1:6379/0
FRIGATE_CI_QUALITY_GATES_ENABLED=true
FRIGATE_READINESS_WARMUP_SEC=20
FRIGATE_READINESS_MIN_PROCESS_FPS=0.1
FRIGATE_READINESS_MAX_SKIPPED_PROCESS_RATIO=2.0
FRIGATE_READINESS_MAX_SSE_FILL_RATIO=0.95

# Reliable delivery (optional webhook fanout)
FRIGATE_HEADLESS_EVENTS_WEBHOOK_URL=
FRIGATE_EVENT_DELIVERY_MAX_ATTEMPTS=5
FRIGATE_EVENT_DELIVERY_BACKOFF_BASE_SEC=1.0
FRIGATE_EVENT_DELIVERY_BACKOFF_MAX_SEC=30.0
FRIGATE_EVENT_DELIVERY_JITTER_RATIO=0.2

# Structured logging
FRIGATE_LOG_FORMAT=json

# Generic config overrides from ENV:
# FRIGATE_CFG__path__to__field=<json_value>
FRIGATE_CFG__mqtt__enabled=true
FRIGATE_CFG__record__enabled=false

# Optional full config overlay as JSON
# FRIGATE_CONFIG_JSON={"cameras":{"front":{"enabled":true}}}
