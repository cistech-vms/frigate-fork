# Production-oriented example for headless deployments.
# Run scripts/bootstrap_headless_deploy.sh to create .env and replace placeholders.
FRIGATE_HEADLESS=true
FRIGATE_INSTALLER_ENABLED=true

# Authentication mode: hmac | jwt
FRIGATE_API_AUTH_MODE=hmac
FRIGATE_API_HMAC_KEYS_JSON=__GENERATE__
FRIGATE_API_HMAC_MAX_SKEW_SEC=300
FRIGATE_API_JWT_SECRET=__GENERATE__
FRIGATE_API_RATE_LIMIT_PER_MIN=120
FRIGATE_API_RATE_LIMIT_BLOCK_BASE_SEC=30
FRIGATE_API_RATE_LIMIT_BLOCK_MAX_SEC=900

# Optional single-tenant pin.
FRIGATE_TENANT_ID=tenant-local
FRIGATE_CORS_ALLOWLIST=
FRIGATE_METRICS_ENABLED=true

# Runtime/readiness gates.
FRIGATE_DB_DRIVER=sqlite
FRIGATE_REDIS_ENABLED=false
FRIGATE_REDIS_URL=redis://127.0.0.1:6379/0
FRIGATE_CI_QUALITY_GATES_ENABLED=true
FRIGATE_READINESS_WARMUP_SEC=20
FRIGATE_READINESS_MIN_PROCESS_FPS=0.1
FRIGATE_READINESS_MAX_SKIPPED_PROCESS_RATIO=2.0
FRIGATE_READINESS_MAX_SSE_FILL_RATIO=0.95

# Reliable delivery (optional webhook fanout).
FRIGATE_HEADLESS_EVENTS_WEBHOOK_URL=
FRIGATE_EVENT_DELIVERY_MAX_ATTEMPTS=5
FRIGATE_EVENT_DELIVERY_BACKOFF_BASE_SEC=1.0
FRIGATE_EVENT_DELIVERY_BACKOFF_MAX_SEC=30.0
FRIGATE_EVENT_DELIVERY_JITTER_RATIO=0.2

# CMS remote control-plane integration.
FRIGATE_CMS_REQUIRED=false
FRIGATE_CMS_URL=
FRIGATE_CMS_AUTH_MODE=token
FRIGATE_CMS_TOKEN=
FRIGATE_CMS_USERNAME=
FRIGATE_CMS_PASSWORD=
FRIGATE_TENANT_CODE=
FRIGATE_CMS_SYNC_INTERVAL_SEC=60
FRIGATE_CMS_REQUEST_TIMEOUT_SEC=8.0
FRIGATE_CMS_LICENSE_GRACE_SEC=900

# Structured logging.
FRIGATE_LOG_FORMAT=json

# Generic config overrides from ENV.
FRIGATE_CFG__mqtt__enabled=true
FRIGATE_CFG__record__enabled=true
